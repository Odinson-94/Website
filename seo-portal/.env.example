# Private portal access (generate a long random value; never commit the real one)
SEO_PORTAL_TOKEN=

# Vercel adds this to scheduled requests as Authorization: Bearer <value>
CRON_SECRET=

# Existing Adelphos Supabase project
SUPABASE_URL=https://owebjrorrthysyeodkku.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional third-party independent SERP checks (leave blank for GSC-only mode)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SEO_SERP_DEPTH=20
SEO_MAX_KEYWORDS_PER_RUN=25

# Search Console Domain property and service-account JSON.
# JSON may be literal or base64-encoded. Add client_email from the JSON as a
# user of this exact property in Search Console.
GSC_PROPERTY=sc-domain:adelphos.ai
GSC_SERVICE_ACCOUNT_JSON=

# Optional: fresh country-specific keyword volumes and related ideas. The
# existing GSC service-account JSON is reused for OAuth after that same email is
# added as a user in Google Ads. Keep the developer token server-side.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
# Allowed user-selectable research markets (ISO alpha-2 codes).
GOOGLE_ADS_MARKETS=AU,CA,GB,IE,IN,NZ,SG,AE,US
